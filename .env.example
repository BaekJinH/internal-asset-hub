# 실제 값은 이 파일이 아니라 프로젝트 루트의 `.env`에 넣으세요.
# cp .env.example .env 후 .env만 수정합니다 (.env는 gitignore됨).

# Notion Integration (https://www.notion.so/my-integrations)
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_PROJECTS_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub — org별 fine-grained PAT
# private org(tintolab-publishing 등)는 Resource owner + All repositories(또는 대상 repo) + Metadata(Read) 필수
GITHUB_DEVELOPMENT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_PUBLISHING=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# org별 토큰이 없을 때만 사용하는 공통 fallback
GITHUB_TOKEN=

# GitHub org 이름
GITHUB_ORG=tintolab-development
GITHUB_ORG_PUBLISHING=tintolab-publishing
# GITHUB_ORG_DESIGN=tintolab-design

# Figma REST API (Personal Access Token — Settings > Security > Personal access tokens)
FIGMA_PAT=
FIGMA_TEST_FILE_KEY=
FIGMA_TEAM_ID=1132177377948917434
# 최근 N일 이내 수정된 파일만 sync (0 = 전체)
FIGMA_SYNC_ACTIVE_DAYS=30
# API 호출 간격(ms) — rate limit 시 4000 이상 권장
FIGMA_API_MIN_INTERVAL_MS=2500
# P1 OAuth: FIGMA_CLIENT_ID=, FIGMA_CLIENT_SECRET=

# API server
PORT=3001
