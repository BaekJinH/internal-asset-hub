# DevPilot engine — env template. COPY to a gitignored .env; NEVER commit real values.
# (Named `env.example` not `.env.example` to satisfy a secret-guard; rename on the wiring milestone
#  when dotenv is actually loaded. Phase-1 cloud + Phase-2 Ollama are BOTH deferred until reachable.)

# ── Phase-1 analyze (cloud Gemini, @google/generative-ai) ──────────────────────
# Faithful to devpilot-v2@d262aa3 src/models/gemini-client.ts: key gates the client (disabled if unset).
GEMINI_API_KEY=
# Optional model override; devpilot default = gemini-3.5-flash.
GEMINI_MODEL_ID=gemini-3.5-flash

# ── Phase-2 codegen (company Ollama server — GPU host, NOT Vercel) ─────────────
# n8n v31 stack: qwen3-coder:30b (codegen) / deepseek-r1:32b (verify). Endpoint = company cred.
OLLAMA_BASE_URL=
OLLAMA_MODEL_CODEGEN=qwen3-coder:30b
OLLAMA_MODEL_VERIFY=deepseek-r1:32b
